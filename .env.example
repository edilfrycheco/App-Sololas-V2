# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Postgres connection string used by Drizzle for migrations)
# For Supabase, use the "Connection Pooling" string in transaction mode for the app,
# and the direct (Session mode / port 5432) string for `drizzle-kit push` / `migrate`.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
